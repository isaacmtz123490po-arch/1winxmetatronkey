(version 1)
(allow default)
(deny iokit-open-user-client
	(require-all
		(require-not (iokit-user-client-class "AppleSMCClient"))
		(require-not (iokit-user-client-class "IOSurfaceAcceleratorClient"))
		(require-not (iokit-user-client-class "IOMobileFramebufferUserClient"))
		(iokit-user-client-class "AppleKeyStoreUserClient")))
(deny iokit-open-service
	(iokit-user-client-class "AppleSMC"))
(deny mach-lookup
	(require-all
		(require-not (global-name "com.apple.diagnosticd"))
		(require-not (global-name "com.apple.commcenter.xpc"))
		(require-not (global-name "com.apple.system.notification_center"))
		(require-not (global-name "com.apple.system.libinfo.muser"))
		(require-not (global-name "com.apple.system.logger"))
		(require-not (global-name "com.apple.logd"))
		(global-name "com.apple.cfprefsd.daemon")))
(deny syscall-mach
	(require-all
		(require-not (syscall-number-bitmask-regex exit | fork | read | write | open | sys_close | wait4 | unlink | chmod | chown | getpid | getuid | geteuid | access | pipe | getegid | sigaction | getgid | sigprocmask | sigaltstack | ioctl | readlink | execve | munmap | mprotect | madvise | mincore | sys_dup2 | sys_fcntl | fsync | socket | connect | gettimeofday | writev | fchmod | rename | sendto | mkdir | rmdir | pread | unmount | csops | csops_audittoken | kdebug_typefilter | kdebug_trace_string | kdebug_trace64 | seteuid | pathconf | getrlimit | mmap | lseek | truncate | sysctl | open_dprotected_np | getattrlist | fgetattrlist | fsetxattr | listxattr | fsctl | posix_spawn | shm_open | sem_unlink | sys_sysctlbyname | gettid | shared_region_check_np | psynch_mutexwait | psynch_mutexdrop | psynch_cvbroad | psynch_cvwait | psynch_rw_rdlock | psynch_rw_unlock | iopolicysys | issetugid | __pthread_sigmask | __disable_threadsignal | __semwait_signal | proc_info | stat64 | sys_fstat64 | lstat64 | getdirentries64 | statfs64 | fstatfs64 | getfsstat64 | bsdthread_create | bsdthread_terminate | bsdthread_register | workq_open | workq_kernreturn | kevent_qos | kevent_id | __mac_syscall | read_nocancel | write_nocancel | open_nocancel | sys_close_nocancel | sys_fcntl_nocancel | sigsuspend_nocancel | __semwait_signal_nocancel | fsgetpath | memorystatus_control | getattrlistbulk | openat | faccessat | fstatat64 | mkdirat | bsdthread_ctl | getentropy | sys_ulock_wait | sys_ulock_wake | fs_snapshot | abort_with_payload | os_fault_with_payload | objc_bp_assist_cfg_np))
		(require-not (syscall-number writev_nocancel))
		(require-not (syscall-number wait4_nocancel))
		(require-not (syscall-number work_interval_ctl))
		(require-not (syscall-number utimes))
		(require-not (syscall-number unlinkat))
		(require-not (syscall-number umask))
		(require-not (syscall-number thread_selfusage))
		(require-not (syscall-number terminate_with_payload))
		(require-not (syscall-number symlink))
		(require-not (syscall-number stat64_extended))
		(require-not (syscall-number socketpair))
		(require-not (syscall-number sigreturn))
		(require-not (syscall-number sigsuspend))
		(require-not (syscall-number shutdown))
		(require-not (syscall-number shm_unlink))
		(require-not (syscall-number shared_region_map_and_slide_2_np))
		(require-not (syscall-number setrlimit))
		(require-not (syscall-number setxattr))
		(require-not (syscall-number setsockopt))
		(require-not (syscall-number setattrlist))
		(require-not (syscall-number setattrlistat))
		(require-not (syscall-number sendto_nocancel))
		(require-not (syscall-number sendmsg_nocancel))
		(require-not (syscall-number sendmsg))
		(require-not (syscall-number sem_open))
		(require-not (syscall-number select))
		(require-not (syscall-number select_nocancel))
		(require-not (syscall-number sem_close))
		(require-not (syscall-number renameat))
		(require-not (syscall-number renameatx_np))
		(require-not (syscall-number recvfrom))
		(require-not (syscall-number removexattr))
		(require-not (syscall-number recvmsg))
		(require-not (syscall-number recvfrom_nocancel))
		(require-not (syscall-number recvmsg_nocancel))
		(require-not (syscall-number pwrite_nocancel))
		(require-not (syscall-number psynch_rw_wrlock))
		(require-not (syscall-number pwrite))
		(require-not (syscall-number psynch_cvsignal))
		(require-not (syscall-number psynch_cvclrprepost))
		(require-not (syscall-number pselect))
		(require-not (syscall-number proc_rlimit_control))
		(require-not (syscall-number proc_info_extended_id))
		(require-not (syscall-number pselect_nocancel))
		(require-not (syscall-number pread_nocancel))
		(require-not (syscall-number persona))
		(require-not (syscall-number openat_nocancel))
		(require-not (syscall-number necp_open))
		(require-not (syscall-number necp_client_action))
		(require-not (syscall-number msync_nocancel))
		(require-not (syscall-number msync))
		(require-not (syscall-number mremap_encrypted))
		(require-not (syscall-number lstat64_extended))
		(require-not (syscall-number lchown))
		(require-not (syscall-number kqueue))
		(require-not (syscall-number kill))
		(require-not (syscall-number link))
		(require-not (syscall-number kqueue_workloop_ctl))
		(require-not (syscall-number listen))
		(require-not (syscall-number kevent))
		(require-not (syscall-number guarded_close_np))
		(require-not (syscall-number guarded_write_np))
		(require-not (syscall-number guarded_open_dprotected_np))
		(require-not (syscall-number guarded_open_np))
		(require-not (syscall-number guarded_pwrite_np))
		(require-not (syscall-number getxattr))
		(require-not (syscall-number getsockname))
		(require-not (syscall-number getrusage))
		(require-not (syscall-number getsockopt))
		(require-not (syscall-number getpriority))
		(require-not (syscall-number getppid))
		(require-not (syscall-number getpeername))
		(require-not (syscall-number getgroups))
		(require-not (syscall-number sys_getdtablesize))
		(require-not (syscall-number getauid))
		(require-not (syscall-number fsync_nocancel))
		(require-not (syscall-number ftruncate))
		(require-not (syscall-number sys_fstat64_extended))
		(require-not (syscall-number fsetattrlist))
		(require-not (syscall-number fremovexattr))
		(require-not (syscall-number sys_fpathconf))
		(require-not (syscall-number sys_fileport_makefd))
		(require-not (syscall-number fgetxattr))
		(require-not (syscall-number flistxattr))
		(require-not (syscall-number sys_fileport_makeport))
		(require-not (syscall-number sys_flock))
		(require-not (syscall-number ffsctl))
		(require-not (syscall-number fchown))
		(require-not (syscall-number fchmodat))
		(require-not (syscall-number fchownat))
		(require-not (syscall-number fchmod_extended))
		(require-not (syscall-number sys_fchdir))
		(require-not (syscall-number fchflags))
		(require-not (syscall-number sys_dup))
		(require-not (syscall-number connectx))
		(require-not (syscall-number connect_nocancel))
		(require-not (syscall-number clonefileat))
		(require-not (syscall-number chmod_extended))
		(require-not (syscall-number chflags))
		(require-not (syscall-number sys_chdir))
		(require-not (syscall-number change_fdguard_np))
		(require-not (syscall-number access_extended))
		(require-not (syscall-number bind))
		(require-not (syscall-number accept))
		(require-not (syscall-number accept_nocancel))
		(require-not (syscall-number __pthread_kill))
		(require-not (syscall-number __pthread_chdir))
		(require-not (syscall-number __pthread_fchdir))
		(require-not (syscall-number __pthread_canceled))
		(syscall-number __channel_open)
		(syscall-number __channel_sync)
		(syscall-number __channel_get_info)))
(deny sysctl*
	(require-all
		(require-not (machtrap-number-bitmask-regex machtrap_number_9 | machtrap_number_9 | MSC__kernelrpc_mach_vm_purgable_control_trap | machtrap_number_17 | MSC__kernelrpc_mach_port_mod_refs_trap | MSC__kernelrpc_mach_port_deallocate_trap | machtrap_number_17 | MSC_thread_self_trap | MSC__kernelrpc_mach_port_destruct_trap | MSC_thread_self_trap | MSC_mach_reply_port | MSC__kernelrpc_mach_port_unguard_trap | MSC_mach_generate_activity_id | MSC_macx_swapoff | MSC_pfz_exit | machtrap_number_65 | machtrap_number_73 | machtrap_number_75 | MSC_mach_wait_until | MSC_mach_wait_until | MSC_mach_timebase_info_trap))
		(require-not (machtrap-number MSC_thread_self_trap))
		(require-not (machtrap-number MSC_task_dyld_process_info_notify_get))
		(require-not (machtrap-number MSC_task_name_for_pid))
		(require-not (machtrap-number MSC_semaphore_timedwait_trap))
		(require-not (machtrap-number MSC_semaphore_wait_trap))
		(require-not (machtrap-number MSC_semaphore_signal_trap))
		(require-not (machtrap-number MSC_swtch_pri))
		(require-not (machtrap-number MSC_pid_for_task))
		(require-not (machtrap-number MSC_mk_timer_arm))
		(require-not (machtrap-number MSC_mk_timer_cancel))
		(require-not (machtrap-number MSC_mk_timer_arm_leeway))
		(require-not (machtrap-number MSC_mach_msg_overwrite_trap))
		(require-not (machtrap-number MSC__kernelrpc_mach_vm_purgable_control_trap))
		(require-not (machtrap-number MSC__kernelrpc_mach_port_get_attributes_trap))
		(require-not (machtrap-number MSC__kernelrpc_mach_port_extract_member_trap))))
